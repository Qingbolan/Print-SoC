{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Print_at_SoC",
  "version": "1.0.0",
  "identifier": "tech.silan.PrintAtSoC",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Print@SoC — NUS SoC document printing",
        "width": 1400,
        "height": 900,
        "minWidth": 480,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "titleBarStyle": "Visible",
        "transparent": false
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        {
          "identifier": "main-capability",
          "windows": [
            "main"
          ],
          "permissions": [
            "core:default",
            "core:window:allow-start-dragging",
            "core:window:allow-set-size",
            "core:window:allow-set-position",
            "core:window:allow-toggle-maximize",
            "core:window:allow-set-theme",
            "core:path:default",
            "core:event:allow-listen",
            "shell:allow-open",
            "dialog:allow-open",
            "dialog:allow-save",
            "dialog:allow-message",
            "dialog:allow-ask",
            "dialog:allow-confirm",
            {
              "identifier": "fs:allow-read-file",
              "allow": [
                {
                  "path": "$DOCUMENT/**"
                },
                {
                  "path": "$HOME/**"
                }
              ]
            },
            {
              "identifier": "fs:allow-read-dir",
              "allow": [
                {
                  "path": "$DOCUMENT/**"
                },
                {
                  "path": "$HOME/**"
                }
              ]
            },
            {
              "identifier": "fs:allow-write-file",
              "allow": [
                {
                  "path": "$DOCUMENT/**"
                },
                {
                  "path": "$HOME/**"
                }
              ]
            },
            {
              "identifier": "fs:allow-exists",
              "allow": [
                {
                  "path": "$DOCUMENT/**"
                },
                {
                  "path": "$HOME/**"
                }
              ]
            },
            {
              "identifier": "fs:allow-read-text-file",
              "allow": [
                {
                  "path": "$DOCUMENT/**"
                },
                {
                  "path": "$HOME/**"
                }
              ]
            },
            "fs:default",
            "geolocation:allow-get-current-position",
            "geolocation:allow-watch-position",
            "geolocation:allow-clear-watch",
            "geolocation:allow-check-permissions",
            "geolocation:allow-request-permissions"
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Silan Hu(silan.hu@u.nus.edu).",
    "copyright": "© 2025 Silan Hu.",
    "category": "Productivity",
    "shortDescription": "NUS SoC printing with document preview and print history",
    "longDescription": "Print@SoC is an open-source desktop app for National University of Singapore School of Computing users. Preview PDFs, images and Office documents, choose paper and duplex settings, and track jobs submitted through the school’s SSH printing service. Available on Windows, macOS and Linux, with guided virtual printer setup on macOS/Linux. Requires a SoC account and network access; Office conversion requires LibreOffice.",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0 | libwebkit2gtk-4.0-37",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "libssl3 | libssl1.1"
        ],
        "section": "science",
        "priority": "optional"
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "librsvg2",
          "openssl-libs"
        ],
        "release": "1",
        "epoch": 0
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "entitlements": "entitlements.plist",
      "minimumSystemVersion": "11.0",
      "frameworks": [],
      "signingIdentity": null
    },
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "wix": {
        "language": [
          "en-US"
        ],
        "template": null,
        "version": "1.0.0"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine"
      }
    }
  }
}
